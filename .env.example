# Gemini API key (server-only; never sent to the browser)
NUXT_GEMINI_API_KEY=
# Optional model overrides
# NUXT_LIVE_MODEL=gemini-3.8-live
# NUXT_TEXT_MODEL=gemini-3.8-flash

# "local" stores data in .data/ (development). "firestore" uses Firestore in the Firebase project below;
# locally that needs `gcloud auth application-default login`.
NUXT_STORAGE=local

# Firebase web config (public). Leave empty to run without Firebase sign-in.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
